{
  "name": "hasan-rizki-portfolio",
  "version": "1.0.0",
  "description": "Portfolio Backend & Systems — Hasan Rizki Sulaiman",
  "scripts": {
    "dev": "npx tailwindcss -i ./src/input.css -o ./dist/output.css --watch",
    "build": "npx tailwindcss -i ./src/input.css -o ./dist/output.css --minify",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d . -e ."
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0"
  }
}
